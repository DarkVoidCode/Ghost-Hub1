-- ============================================================
-- AIMBOT LOGIC
-- ============================================================
local function IsVisible(part)
    if not Config.Aimbot.VisibleCheck then return true end
    
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = Workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), rayParams)
    
    if result then
        return result.Instance:IsDescendantOf(part.Parent)
    end
    
    return true
end

local function FindTarget()
    local closest = nil
    local shortestDistance = Config.Aimbot.FOV
    
    local viewportSize = Camera.ViewportSize
    local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        
        if Config.Aimbot.TeamCheck and player.Team and LocalPlayer.Team then
            if player.Team == LocalPlayer.Team then continue end
        end
        
        local targetPart = player.Character:FindFirstChild(Config.Aimbot.TargetPart)
        if not targetPart then continue end
        
        -- Verificar distância total
        local distance3D = (Camera.CFrame.Position - targetPart.Position).Magnitude
        if distance3D > 1000 then continue end
        
        -- Verificar visibilidade
        if not IsVisible(targetPart) then continue end
        
        -- Verificar se está na tela
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        
        -- Calcular distância 2D do centro
        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
        local distance2D = (screenPos2D - screenCenter).Magnitude
        
        if distance2D < shortestDistance then
            shortestDistance = distance2D
            closest = player
        end
    end
    
    return closest
end

RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end
    
    -- Encontrar alvo
    local target = FindTarget()
    
    if target and target.Character then
        local targetPart = target.Character:FindFirstChild(Config.Aimbot.TargetPart)
        if targetPart then
            -- Mirar suavemente na cabeça
            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Aimbot.Smoothness)
        end
    end
end)

-- ============================================================
-- ESP LOGIC
-- ============================================================
local function CreateESP(player)
    if player == LocalPlayer then return end
    
    local esp = {}
    
    -- Box
    local box = Drawing.new("Square")
    box.Thickness = 1.5
    box.Color = Color3.fromRGB(180, 140, 255)
    box.Filled = false
    box.Transparency = 1
    box.Visible = false
    esp.Box = box
    
    -- Line (Tracer)
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = Color3.fromRGB(180, 140, 255)
    line.Transparency = 1
    line.Visible = false
    esp.Line = line
    
    -- Name
    local name = Drawing.new("Text")
    name.Size = 14
    name.Center = true
    name.Outline = true
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Visible = false
    esp.Name = name
    
    -- Distance
    local distance = Drawing.new("Text")
    distance.Size = 12
    distance.Center = true
    distance.Outline = true
    distance.Color = Color3.fromRGB(255, 210, 0)
    distance.Visible = false
    esp.Distance = distance
    
    State.ESPCache[player] = esp
end

local function UpdateESP(player)
    local esp = State.ESPCache[player]
    if not esp then return end
    
    if not Config.ESP.Enabled or not player.Character then
        if esp.Box then esp.Box.Visible = false end
        if esp.Line then esp.Line.Visible = false end
        if esp.Name then esp.Name.Visible = false end
        if esp.Distance then esp.Distance.Visible = false end
        return
    end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        if esp.Box then esp.Box.Visible = false end
        if esp.Line then esp.Line.Visible = false end
        if esp.Name then esp.Name.Visible = false end
        if esp.Distance then esp.Distance.Visible = false end
        return
    end
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    local head = player.Character:FindFirstChild("Head")
    if not hrp or not head then return end
    
    -- Calcular distância
    local distanceValue = (Camera.CFrame.Position - hrp.Position).Magnitude
    if distanceValue > Config.ESP.MaxDistance then
        if esp.Box then esp.Box.Visible = false end
        if esp.Line then esp.Line.Visible = false end
        if esp.Name then esp.Name.Visible = false end
        if esp.Distance then esp.Distance.Visible = false end
        return
    end
    
    -- Posições na tela
    local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
    local rootPos, rootOnScreen = Camera:WorldToViewportPoint(hrp.Position)
    
    if not headOnScreen or not rootOnScreen or headPos.Z <= 0 then
        if esp.Box then esp.Box.Visible = false end
        if esp.Line then esp.Line.Visible = false end
        if esp.Name then esp.Name.Visible = false end
        if esp.Distance then esp.Distance.Visible = false end
        return
    end
    
    -- Calcular tamanho da box
    local height = math.abs(headPos.Y - rootPos.Y) * 1.2
    local width = height * 0.65
    
    local x = headPos.X - width / 2
    local y = headPos.Y - height * 0.1
    
    -- Atualizar Box
    if Config.ESP.Box and esp.Box then
        esp.Box.Size = Vector2.new(width, height)
        esp.Box.Position = Vector2.new(x, y)
        esp.Box.Visible = true
    elseif esp.Box then
        esp.Box.Visible = false
    end
    
    -- Atualizar Line
    if Config.ESP.Line and esp.Line then
        local viewportSize = Camera.ViewportSize
        esp.Line.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
        esp.Line.To = Vector2.new(headPos.X, y + height)
        esp.Line.Visible = true
    elseif esp.Line then
        esp.Line.Visible = false
    end
    
    -- Atualizar Name
    if Config.ESP.Name and esp.Name then
        esp.Name.Text = player.Name
        esp.Name.Position = Vector2.new(headPos.X, y - 18)
        esp.Name.Visible = true
    elseif esp.Name then
        esp.Name.Visible = false
    end
    
    -- Atualizar Distance
    if Config.ESP.Distance and esp.Distance then
        local distText = math.floor(distanceValue) .. "m"
        esp.Distance.Text = distText
        esp.Distance.Position = Vector2.new(headPos.X, y + height + 4)
        esp.Distance.Visible = true
    elseif esp.Distance then
        esp.Distance.Visible = false
    end
end

